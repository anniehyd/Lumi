# ─── Core ───
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Database ───
DATABASE_URL=postgresql://lumi:lumi@localhost:5432/lumi?schema=public

# ─── Redis (BullMQ) ───
REDIS_URL=redis://localhost:6379

# ─── Google OAuth (Gmail + Calendar) ───
# Create at https://console.cloud.google.com/apis/credentials
# Required scopes:
#   openid email profile
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Extraction LLM ───
# Provider is inferred from LLM_MODEL: claude* → anthropic, anything else → qwen.
# Set LLM_PROVIDER only to override that.
LLM_MODEL=claude-haiku-4-5

# Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL is the legacy name for LLM_MODEL; LLM_MODEL wins if both are set.

# Qwen, or any OpenAI-compatible endpoint. Leave LLM_BASE_URL unset for
# Alibaba Model Studio international.
#   Model Studio (intl) https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Model Studio (CN)   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Together            https://api.together.xyz/v1
#   OpenRouter          https://openrouter.ai/api/v1
#   local vLLM / Ollama http://localhost:8000/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=
# LLM_BASE_URL=

# ─── Gmail push (optional; falls back to polling if unset) ───
# Cloud Pub/Sub topic you own: projects/{project}/topics/{topic}
GMAIL_PUBSUB_TOPIC=
# Shared secret to verify Pub/Sub push requests (any random string)
GMAIL_WEBHOOK_SECRET=

# ─── Background scanning ───
# Which mail Lumi is allowed to read (Gmail search syntax). Default is the
# inbox only, minus Promotions/Social/Updates/Forums — archived and sent mail
# are excluded too. Set to e.g. label:Lumi to read only a label you curate.
INGEST_GMAIL_FILTER=

# Worker sweeps every connected inbox at these local times (24h HH:MM,
# comma-separated); leave empty to disable scheduled sweeps entirely.
INGEST_SWEEP_TIMES=13:00,19:00
INGEST_SWEEP_TZ=America/New_York
# Also sweep once when the worker boots — handy in dev, off in prod so
# restarts don't add unscheduled scans.
INGEST_SWEEP_ON_START=false

# ─── Handshake ───
# Handshake exposes no student API, but every account has a personal iCal
# export: Handshake → Settings → Calendar export → "Copy calendar link".
# Paste it here for single-user deploys; multi-user installs set it per user
# via PUT /api/sources/handshake instead. webcal:// links are accepted.
HANDSHAKE_ICS_URL=

# ─── Calendar subscription feed (Apple Calendar etc.) ───
# openssl rand -hex 24 — feed URL is /api/calendar.ics?token=<this>
CALENDAR_FEED_TOKEN=
# Which user's events the feed serves; defaults to the sole user in the DB
CALENDAR_FEED_EMAIL=

# ─── Runtime ───
NODE_ENV=development
# When true, API falls back to mock data if DB is empty
LUMI_USE_MOCK_FALLBACK=true

# ─── External sweep trigger (optional) ───
# Set to enable POST /api/cron/sweep. Without it the route returns 503 rather
# than running an unauthenticated sweep.
#   curl -X POST https://lumi-live.fly.dev/api/cron/sweep -H "authorization: Bearer $CRON_SECRET"
CRON_SECRET=
