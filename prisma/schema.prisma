generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  timezone         String    @default("America/New_York")
  // Personal Handshake iCal export URL (Settings → Calendar export → Copy
  // calendar link). Null = Handshake ingestion off for this user.
  handshakeFeedUrl String?
  // Set when the one-time onboarding flow completes. Null = show onboarding.
  onboardedAt      DateTime?
  // Secret for this user's iCal subscription feed (/api/calendar.ics?token=).
  // Calendar apps cannot sign in, so the token is the credential. Null until
  // the user first opens the feed section in Settings; rotated on request.
  calendarFeedToken String?  @unique
  // Secret in this user's forwarding address (lumi+<token>@INBOUND_EMAIL_DOMAIN).
  // Mail sent there is ingested for this user by POST /api/ingest/inbound, so
  // a user never has to grant Gmail access. Null until they open the
  // "Forward to Lumi" section in Settings; rotated on request.
  forwardingToken   String?  @unique
  // What this user wants Lumi to surface. Shape: src/lib/profile.ts UserProfile.
  // Null falls back to DEFAULT_PROFILE so extraction never breaks on a new user.
  profile          Json?
  accounts         Account[]
  sessions         Session[]
  emails           Email[]
  events           Event[]
  misses           Miss[]
  senderStats      SenderStat[]
  metrics          MetricDaily[]
}

/// A user telling us we failed to surface something. The only recall signal we
/// have — accept/decline on Event only measures precision.
model Miss {
  id        String   @id @default(cuid())
  userId    String
  note      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Lumi Models ───

model Email {
  id         String   @id @default(cuid())
  userId     String
  // RFC 5322 Message-ID header. Unique per user, not globally: the same
  // mailing-list message legitimately lands in two users' inboxes.
  messageId  String
  // Gmail's own id for the message — lets a sweep skip mail it has already
  // ingested before paying for the raw fetch. Null for rows that predate it.
  gmailId    String?
  threadId   String?
  from       String
  subject    String
  bodyText   String?  @db.Text
  bodyHtml   String?  @db.Text
  receivedAt DateTime
  hasIcs     Boolean  @default(false)
  processed  Boolean  @default(false)
  // Detection attempts so far. A failed extraction is retried on later sweeps
  // until this reaches the cap, instead of being lost on the first error.
  attempts   Int      @default(0)
  // sha256 of sender + subject + normalized body (src/lib/detection/prefilter.ts).
  contentHash String?
  // Why no model call was made for this email, when one was skipped.
  skipReason String?
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([userId, messageId])
  @@index([userId, processed])
  @@index([userId, gmailId])
  @@index([userId, contentHash])
  @@index([userId, threadId])
}

/// Per-sender track record for the pre-filter: how many model calls this
/// sender's mail has cost and how many events came out. A bulk sender that
/// keeps producing nothing is muted (with periodic probes) — see
/// shouldMuteSender in src/lib/detection/prefilter.ts.
model SenderStat {
  userId            String
  sender            String
  llmCalls          Int      @default(0)
  eventsFound       Int      @default(0)
  skippedSinceProbe Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sender])
}

/// Pipeline funnel, one row per user per UTC day. Unlike Email, Event and
/// LlmUsage this table is never purged, so lifetime numbers survive the
/// 14-day retention window. Definitions: docs/METRICS.md.
model MetricDaily {
  userId String
  day    String // UTC date, YYYY-MM-DD

  emailsScanned   Int @default(0) // new emails that entered the pipeline
  emailsSkipped   Int @default(0) // stopped by the keyword gate or pre-filter
  emailsToModel   Int @default(0) // extraction calls made
  eventsFound     Int @default(0) // events extracted by any tier, before dedup
  eventsCreated   Int @default(0) // event cards shown to the user
  eventsAccepted  Int @default(0) // transitions into ACCEPTED
  eventsDeclined  Int @default(0) // transitions into DECLINED
  eventsMaybe     Int @default(0) // transitions into MAYBE
  acceptsReverted Int @default(0) // transitions out of ACCEPTED
  llmInputTokens  Int @default(0)
  llmOutputTokens Int @default(0)
  llmUsd          Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Event {
  id          String          @id @default(cuid())
  userId      String
  emailId     String?
  status      EventStatus     @default(PENDING)
  confidence  Float           @default(0)
  detectedVia DetectionMethod
  source      EventSource     @default(EMAIL)
  // Stable upstream id (ICS UID) for feed-sourced events, so re-fetching the
  // same feed updates rather than duplicates. Null for email-derived events.
  sourceUid   String?

  // Core fields
  title       String
  description String?   @db.Text
  // One plain sentence for the card, "Looks like …": who is doing what, for
  // whom. Written by the model in the extraction call; the parser tiers and
  // the Handshake feed get a templated one (src/lib/brief.ts summaryFor).
  summary     String?   @db.Text
  date        String // ISO date: 2026-03-28
  startTime   DateTime // Full ISO 8601 with offset
  endTime     DateTime?
  timezone    String    @default("America/New_York")
  isAllDay    Boolean   @default(false)

  // Location
  locationType    LocationType?
  locationName    String?
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  virtualUrl      String?
  virtualPlatform String?

  // Organizer
  organizerName    String?
  organizerEmail   String?
  organizerCompany String?

  // Ranking + calendar awareness
  relevance     Int     @default(3) // 1..5 — fit to the user's interests
  conflictTitle String? // title of the overlapping Google Calendar event, if any

  // Extras
  attire       String?
  rsvpLink     String?
  rsvpDeadline DateTime?

  // Recurrence
  recurrenceRule String? // RRULE string

  // Calendar sync
  calendarEventId String? // Google Calendar event ID after sync
  reminderJobId   String? // BullMQ job ID for Maybe reminders

  // Conflict detection
  conflictIds String[] @default([])

  // Dedup
  dedupHash String? // hash(title + date + organizerEmail)

  // Attribution — which model and prompt produced this row. Null for ICS,
  // schema.org and keyword extraction, which involve no model.
  extractedBy   String?
  promptVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceUid])
  @@index([userId, status])
  @@index([userId, date])
  @@index([dedupHash])
}

enum EventStatus {
  PENDING
  ACCEPTED
  MAYBE
  DECLINED
  ARCHIVED
}

enum EventSource {
  EMAIL
  HANDSHAKE
}

enum DetectionMethod {
  ICS
  SCHEMA_ORG
  KEYWORD
  LLM
}

enum LocationType {
  PHYSICAL
  VIRTUAL
  HYBRID
}

/// One row per extraction call. Without it, cost per accepted event — the
/// metric that catches a cheaper model quietly getting worse — is not
/// computable from the database. Purged with the retention window.
model LlmUsage {
  id            String   @id @default(cuid())
  model         String
  provider      String
  promptVersion String?
  inputTokens   Int
  outputTokens  Int
  events        Int
  usd           Float?
  ms            Int
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([model, createdAt])
}
